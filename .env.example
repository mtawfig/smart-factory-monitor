# SmartFactory AI — local development variables
# Copy to .env (git-ignored) and replace every placeholder. These values are for
# the Docker Compose stack on your own machine only. Nothing here is a real secret
# and nothing real must ever be written into this file or committed.

# PostgreSQL superuser for the local stack (also used by Keycloak and MLflow).
POSTGRES_USER=smartfactory
POSTGRES_PASSWORD=replace-me-local-only

# Keycloak bootstrap administrator (master realm). Change on first login.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me-local-only

# Password given to every seeded persona user (planner, technician, ...).
DEV_USER_PASSWORD=replace-me-local-only
