{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Platform": "Host=localhost;Port=5432;Database=smartfactory;Username=smartfactory;Include Error Detail=true",
